{
  "services": {
    "my_frontend": {
      "runtime": "container",
      "root": "frontend/",
      "entrypoin": "docker/Dockerfile.vercel"
    },
    "my_backend": {
      "runtime": "container",
      "root": "backend/",
      "entrypoint": "docker/Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "my_backend" } },
    { "source": "/(.*)", "destination": { "service": "my_frontend" } }
  ]
}